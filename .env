# Copy to .env and edit. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local default (no setup needed, creates backend/foodverse.db):
DATABASE_URL=sqlite:///./foodverse.db
# PostgreSQL examples (Neon / Supabase / Render / local):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Hosted Postgres usually needs SSL, e.g. append  ?sslmode=require

# --- CORS (comma separated list of frontend origins) -----------------------
CORS_ORIGINS=http://localhost:5173

# --- Optional server-side AI keys (otherwise users enter a key in the UI) ---
# GEMINI_API_KEY=
# GROQ_API_KEY=
# LLM_PROVIDER=Gemini

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=25
